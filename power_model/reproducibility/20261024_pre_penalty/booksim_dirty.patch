+bool IQRouter::IsQuiescent() const
+{
+  if(_active || !_in_queue_flits.empty() || !_proc_credits.empty() ||
+     !_route_vcs.empty() || !_vc_alloc_vcs.empty() ||
+     !_sw_hold_vcs.empty() || !_sw_alloc_vcs.empty() ||
+     !_crossbar_flits.empty() || !_out_queue_credits.empty()) {
+    return false;
+  }
+  for(const Buffer * buffer : _buf) {
+    if(buffer->GetOccupancy() != 0) return false;
+    for(int vc = 0; vc < _vcs; ++vc) {
+      if(buffer->GetState(vc) != VC::idle) return false;
+    }
+  }
+  for(const BufferState * state : _next_buf) {
+    if(state->Occupancy() != 0) return false;
+    for(int vc = 0; vc < _vcs; ++vc) {
+      if(!state->IsAvailableFor(vc)) return false;
+    }
+  }
+  for(const auto & output : _output_buffer) {
+    if(!output.empty()) return false;
+  }
+  for(const auto & credits : _credit_buffer) {
+    if(!credits.empty()) return false;
+  }
+  return true;
+}
