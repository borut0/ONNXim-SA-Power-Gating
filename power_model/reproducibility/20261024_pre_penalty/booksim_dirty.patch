+Interconnect::QuiescenceStatus Interconnect::get_quiescence_status() {
+  QuiescenceStatus status;
+  status.observable = true;
+  status.routers_quiescent = true;
+  status.flit_channels_empty = true;
+  status.credit_channels_empty = true;
+  status.injection_queues_empty = true;
+  status.source_buffer_states_quiescent = true;
+  status.ejection_buffers_empty = true;
+  status.boundary_buffers_empty = true;
+  status.retired_flit_queues_empty = true;
+  status.retired_packet_heads_empty = true;
+  status.in_flight_flits_empty = true;
+
+  for(Network * net : nets) {
+    for(const Router * router : net->GetRouters()) {
+      if(!router->QuiescenceObservable()) {
+        status.observable = false;
+        status.routers_quiescent = false;
+      } else if(!router->IsQuiescent()) {
+        status.routers_quiescent = false;
+      }
+    }
+    auto check_flit_channels = [&](const auto & channels) {
+      for(const auto * channel : channels) {
+        if(channel->HasActivity()) status.flit_channels_empty = false;
+      }
+    };
+    auto check_credit_channels = [&](const auto & channels) {
+      for(const auto * channel : channels) {
+        if(channel->HasActivity()) status.credit_channels_empty = false;
+      }
+    };
+    check_flit_channels(net->GetInject());
+    check_flit_channels(net->GetEject());
+    check_flit_channels(net->GetChannels());
+    check_credit_channels(net->GetInjectCred());
+    check_credit_channels(net->GetEjectCred());
+    check_credit_channels(net->GetChannelsCred());
+  }
+
+  status.injection_queues_empty = traffic_manager->InputQueuesEmpty();
+  status.source_buffer_states_quiescent =
+      traffic_manager->SourceBufferStatesQuiescent();
+  status.in_flight_flits_empty = traffic_manager->InFlightFlitsEmpty();
+  status.retired_packet_heads_empty =
+      traffic_manager->RetiredPacketsEmpty();
+  for(int subnet = 0; subnet < num_subnets; ++subnet) {
+    for(int node = 0; node < num_nodes; ++node) {
+      if(!ejected_flit_queue[subnet][node].empty()) {
+        status.retired_flit_queues_empty = false;
+      }
+      for(int vc = 0; vc < vcs; ++vc) {
+        if(!ejection_buffer[subnet][node][vc].empty()) {
+          status.ejection_buffers_empty = false;
+        }
+        if(boundary_buffer[subnet][node][vc].size() != 0) {
+          status.boundary_buffers_empty = false;
+        }
+      }
+    }
+  }
+  return status;
+}
