+bool GNNTrafficManager::InputQueuesEmpty() const {
+  for(const auto & subnet : _input_queue) {
+    for(const auto & node : subnet) {
+      for(const auto & queue : node) {
+        if(!queue.empty()) return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool GNNTrafficManager::InFlightFlitsEmpty() const {
+  for(const auto & flits : _total_in_flight_flits) {
+    if(!flits.empty()) return false;
+  }
+  return true;
+}
+
+bool GNNTrafficManager::RetiredPacketsEmpty() const {
+  for(const auto & packets : _retired_packets) {
+    if(!packets.empty()) return false;
+  }
+  return true;
+}
+
+bool GNNTrafficManager::SourceBufferStatesQuiescent() const {
+  for(const auto & source : _buf_states) {
+    for(const BufferState * state : source) {
+      if(state->Occupancy() != 0) return false;
+      for(int vc = 0; vc < _vcs; ++vc) {
+        if(!state->IsAvailableFor(vc)) return false;
+      }
+    }
+  }
+  return true;
+}
+
 GNNTrafficManager::~GNNTrafficManager()
 {
 }
